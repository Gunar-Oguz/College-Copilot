# Streamlit Community Cloud: App settings -> Secrets. Paste this with real values.
# Locally: copy to .streamlit/secrets.toml (gitignored). Placeholders only in this file.

# Claude API key (console.anthropic.com). Every answer uses it, so access is gated below.
ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-haiku-4-5"   # optional override

# Access by approval. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it revokes every approve and access link.
ACCESS_SECRET = "REPLACE_WITH_A_LONG_RANDOM_STRING"
OWNER_EMAIL = "you@example.com"              # receives access requests
OWNER_PASSCODE = "REPLACE_WITH_A_PASSCODE"   # "Owner sign-in" on the landing page
APP_URL = "https://your-app.streamlit.app"   # used in the emailed links

# Gmail SMTP: create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
SMTP_USER = "you@example.com"
SMTP_PASSWORD = "PASTE_GMAIL_APP_PASSWORD_HERE"

# Cost guard (questions per UTC day)
QUESTIONS_PER_VISITOR = 20
QUESTIONS_PER_DAY = 200
ACCESS_REQUESTS_PER_HOUR = 30

# Database file (defaults shown). The download is checked against data/duckdb_manifest.json.
# DB_URL = "https://github.com/Gunar-Oguz/College-Copilot/releases/download/data-v1/collegecopilot.duckdb"
# DUCKDB_PATH = "/path/to/collegecopilot.duckdb"   # local development: use this file instead

# Local development only:
# DEV_PRINT_LINKS = true   # write approve/access links to the server log when SMTP is not set up
# ACCESS_GATE = "off"      # skip the gate entirely (never on a public deployment)
